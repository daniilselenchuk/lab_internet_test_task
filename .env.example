SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=example-password
SMTP_FROM_EMAIL=user@example.com
CONTACT_OWNER_EMAIL=owner@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=10

GIGACHAT_CREDENTIALS=example-authorization-key
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL_CERTS=false
